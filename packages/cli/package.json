{
  "name": "@obbyx/cli",
  "version": "0.1.1",
  "description": "obbyx command line: Obyte wallet, testnet faucet, paying x402 APIs, payment channels, diagnostics",
  "keywords": [
    "x402",
    "obyte",
    "cli",
    "payments",
    "wallet"
  ],
  "license": "MIT",
  "author": "Alexander Ponomarev",
  "homepage": "https://github.com/Taump/obbyx/tree/master/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Taump/obbyx.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Taump/obbyx/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "obbyx": "./dist/main.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx --conditions=@obbyx/source src/main.ts"
  },
  "dependencies": {
    "@obbyx/obyte": "workspace:^",
    "@obbyx/sdk": "workspace:^",
    "@obbyx/x402-obyte": "workspace:^",
    "@x402/core": "^2.29.0",
    "obyte": "0.2.1",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@types/yargs": "^17.0.35"
  }
}
