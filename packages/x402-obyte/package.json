{
  "name": "@obbyx/x402-obyte",
  "version": "0.2.1",
  "description": "x402 payment mechanisms for the Obyte network: exact (on-chain unit) and batch-settlement (AA payment channels)",
  "keywords": [
    "x402",
    "obyte",
    "payments",
    "micropayments",
    "payment-channels",
    "http-402"
  ],
  "license": "MIT",
  "author": "Alexander Ponomarev",
  "homepage": "https://github.com/Taump/obbyx/tree/master/packages/x402-obyte#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Taump/obbyx.git",
    "directory": "packages/x402-obyte"
  },
  "bugs": {
    "url": "https://github.com/Taump/obbyx/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@obbyx/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@obbyx/obyte": "workspace:^",
    "@x402/core": "^2.29.0",
    "obyte": "0.2.1",
    "zod": "^4.6.7"
  }
}
