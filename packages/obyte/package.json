{
  "name": "@obbyx/obyte",
  "version": "0.1.2",
  "description": "Obyte primitives for x402: networks (CAIP-2), BigInt amounts, unit and signed-message validation, wallet, logging",
  "keywords": [
    "obyte",
    "x402",
    "payments",
    "crypto",
    "byteball"
  ],
  "license": "MIT",
  "author": "Alexander Ponomarev",
  "homepage": "https://github.com/Taump/obbyx/tree/master/packages/obyte#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Taump/obbyx.git",
    "directory": "packages/obyte"
  },
  "bugs": {
    "url": "https://github.com/Taump/obbyx/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@obbyx/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./logger": {
      "@obbyx/source": "./src/logger/index.ts",
      "types": "./dist/logger/index.d.ts",
      "default": "./dist/logger/index.js"
    },
    "./config": {
      "@obbyx/source": "./src/config/index.ts",
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./wallet": {
      "@obbyx/source": "./src/wallet/index.ts",
      "types": "./dist/wallet/index.d.ts",
      "default": "./dist/wallet/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./logger": {
        "types": "./dist/logger/index.d.ts",
        "default": "./dist/logger/index.js"
      },
      "./config": {
        "types": "./dist/config/index.d.ts",
        "default": "./dist/config/index.js"
      },
      "./wallet": {
        "types": "./dist/wallet/index.d.ts",
        "default": "./dist/wallet/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "obyte": "0.2.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0"
  },
  "peerDependencies": {
    "pino-pretty": ">=13"
  },
  "peerDependenciesMeta": {
    "pino-pretty": {
      "optional": true
    }
  }
}
