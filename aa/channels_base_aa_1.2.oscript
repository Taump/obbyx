// Payment channel base AA (v1.2) between two parties A and B.
//
// v1.2: a fraud proof pays the whole balance to the wronged party (the one that did
// not initiate the close), not to trigger.address. In v1.1 any holder of the
// initiator's voucher, including the initiator itself, could take the balance.
//
// params:
//   addressA, addressB - the two parties
//   asset              - 'base' or an asset id
//   timeout            - seconds the closing party has to wait before it can confirm the closure itself
//
// State vars:
//   period             - number of the current channel period (incremented on each closure)
//   balanceA/balanceB  - deposits of each party in the current period
//   spentByA/spentByB  - amounts declared as spent when the closing was initiated
//   close_initiated_by - 'A' or 'B' while closing is in progress
//   close_start_ts     - timestamp when closing was initiated
//   event_id           - sequence number of events broadcast by the AA
{
	init: `{
		$close_timeout = params.timeout;
		$asset = params.asset;
		$addressA = params.addressA;
		$addressB = params.addressB;
		$bFromA = (trigger.address == $addressA);
		$bFromB = (trigger.address == $addressB);
		$bFromParties = ($bFromA OR $bFromB);
		if ($bFromParties)
			$party = $bFromA ? 'A' : 'B';

		// validates the package signed by the peer and returns the amount the peer has spent
		$get_spent_by_peer = ($peer_address) => {
			require(trigger.data.sentByPeer.signed_message.aa_address == this_address, 'signed for another channel');
			require(trigger.data.sentByPeer.signed_message.period == var['period'], 'signed for a different period of this channel');
			require(is_valid_signed_package(trigger.data.sentByPeer, $peer_address), 'invalid signature by peer');
			$amount_spent = trigger.data.sentByPeer.signed_message.amount_spent;
			require(is_integer($amount_spent) AND $amount_spent >= 0, 'bad amount spent by peer: ' || $amount_spent);
			$amount_spent
		};
	}`,
	messages: {
		cases: [

			// one party fills or refills the AA
			{
				if: `{
					$bFromParties AND (
						($asset != 'base' AND trigger.output[[asset=$asset]] > 0)
						OR ($asset == 'base' AND trigger.output[[asset=base]] > 10000)
					)
				}`,
				init: `{
					if (var['close_initiated_by'])
						$refused = 1;
					else
						$period = var['period'] otherwise 1;
				}`,
				messages: [
					// deposit accepted: broadcast the new state of the AA
					{
						if: `{!$refused}`,
						app: 'data',
						payload: {
							open: 1,
							period: `{$period}`,
							"{$addressA}": `{var['balanceA'] + ($bFromA ? trigger.output[[asset=$asset]] : 0)}`,
							"{$addressB}": `{var['balanceB'] + ($bFromB ? trigger.output[[asset=$asset]] : 0)}`,
							event_id: `{var['event_id'] otherwise 1}`,
							trigger_unit: `{trigger.unit}`
						}
					},
					// deposit refused: inform about it
					{
						if: `{$refused}`,
						app: 'data',
						payload: {
							refused: 1,
							trigger_unit: `{trigger.unit}`,
							event_id: `{var['event_id'] otherwise 1}`
						}
					},
					// deposit refused: refund the sender
					{
						if: `{$refused}`,
						app: 'payment',
						payload: {
							asset: `{$asset}`,
							outputs: [
								{
									address: `{trigger.address}`,
									amount: `{$asset == 'base' ? (trigger.output[[asset=base]] - 10000) : trigger.output[[asset=$asset]]}`
								}
							]
						}
					},
					{
						app: 'state',
						state: `{
							var['event_id'] = (var['event_id'] otherwise 1) + 1;
							if (!$refused) {
								if (!var['period'])
									var['period'] = 1;
								var['balance' || $party] += trigger.output[[asset=$asset]];
							}
						}`
					}
				]
			},

			// start closing
			{
				if: `{ $bFromParties AND trigger.data.close AND !var['close_initiated_by'] }`,
				init: `{
					require(is_integer(trigger.data.period) AND trigger.data.period == var['period'], 'wrong period');
					$transferredFromMe = trigger.data.transferredFromMe otherwise 0;
					require(is_integer($transferredFromMe) AND $transferredFromMe >= 0, 'bad amount spent by me: ' || $transferredFromMe);
					$transferredFromPeer = trigger.data.sentByPeer ? $get_spent_by_peer($bFromB ? $addressA : $addressB) : 0;
				}`,
				messages: [
					// broadcast that the channel has received a closing request
					{
						app: 'data',
						payload: {
							closing: 1,
							period: `{var['period']}`,
							initiated_by: `{trigger.address}`,
							"{$addressA}": `{$bFromA ? $transferredFromMe : $transferredFromPeer}`,
							"{$addressB}": `{$bFromB ? $transferredFromMe : $transferredFromPeer}`,
							event_id: `{var['event_id'] otherwise 1}`,
							trigger_unit: `{trigger.unit}`
						}
					},
					{
						app: 'state',
						state: `{
							var['spentByA'] = $bFromA ? $transferredFromMe : $transferredFromPeer;
							var['spentByB'] = $bFromB ? $transferredFromMe : $transferredFromPeer;
							var['close_initiated_by'] = $party;
							var['close_start_ts'] = timestamp;
							var['event_id'] = (var['event_id'] otherwise 1) + 1;
						}`
					}
				]
			},

			// confirm closure
			{
				if: `{ trigger.data.confirm AND var['close_initiated_by'] }`,
				init: `{
					// the initiator has to wait for the timeout, the peer can confirm immediately
					require(
						$bFromParties AND (var['close_initiated_by'] != $party OR timestamp >= var['close_start_ts'] + $close_timeout),
						'too early'
					);
					require(is_integer(trigger.data.period) AND trigger.data.period == var['period'], 'wrong period');
					$additionalTransferredFromMe = trigger.data.additionalTransferredFromMe otherwise 0;
					require(
						is_integer($additionalTransferredFromMe) AND $additionalTransferredFromMe >= 0,
						'bad additionalTransferredFromMe: ' || $additionalTransferredFromMe
					);
					$additionalSpentByA = $party == 'A' ? $additionalTransferredFromMe : 0;
					$additionalSpentByB = $party == 'B' ? $additionalTransferredFromMe : 0;
					$balanceA = var['balanceA'] - var['spentByA'] + var['spentByB'] + $additionalSpentByB - $additionalSpentByA;
					$balanceB = var['balanceB'] - var['spentByB'] + var['spentByA'] + $additionalSpentByA - $additionalSpentByB;
					// balance could be < 0 if an unconfirmed deposit was unaccounted
					$finalBalanceA = $balanceA > 0 ? $balanceA : 0;
					$finalBalanceB = $balanceB > 0 ? $balanceB : 0;
					// fees are paid by the larger party, its output is send-all;
					// this party also collects the accumulated 10Kb bounce fees minus 10Kb to prevent abuse of confirmation bounce fees
					$bALarger = $finalBalanceA >= $finalBalanceB;
				}`,
				messages: [
					{
						if: `{$asset == 'base'}`,
						app: 'payment',
						payload: {
							asset: 'base',
							outputs: [
								{address: `{$addressA}`, amount: `{ $bALarger ? '' : ($finalBalanceA + 10000) }`},
								{address: `{$addressB}`, amount: `{ $bALarger ? ($finalBalanceB + 10000) : '' }`}
							]
						}
					},
					{
						if: `{$asset != 'base'}`,
						app: 'payment',
						payload: {
							asset: 'base',
							outputs: [
								{address: `{$addressA}`, amount: `{ $bALarger ? '' : 10000 }`},
								{address: `{$addressB}`, amount: `{ $bALarger ? 10000 : '' }`}
							]
						}
					},
					{
						if: `{$asset != 'base'}`,
						app: 'payment',
						payload: {
							asset: `{$asset}`,
							outputs: [
								{address: `{$addressA}`, amount: `{ $bALarger ? '' : $finalBalanceA }`},
								{address: `{$addressB}`, amount: `{ $bALarger ? $finalBalanceB : '' }`}
							]
						}
					},
					// indicate that the channel is effectively closed
					{
						app: 'data',
						payload: {
							closed: 1,
							period: `{var['period']}`,
							event_id: `{var['event_id']}`
						}
					},
					{
						app: 'state',
						state: `{
							var['period'] += 1;
							var['close_initiated_by'] = false;
							var['close_start_ts'] = false;
							var['balanceA'] = false;
							var['balanceB'] = false;
							var['spentByA'] = false;
							var['spentByB'] = false;
							var['event_id'] += 1;
						}`
					}
				]
			},

			// fraud proof: the closing party declared less than it actually spent
			{
				if: `{ trigger.data.fraud_proof AND var['close_initiated_by'] AND trigger.data.sentByPeer }`,
				init: `{
					$bInitiatedByA = (var['close_initiated_by'] == 'A');
					$wronged_party = $bInitiatedByA ? $addressB : $addressA; // v1.2: was trigger.address
					$transferredFromPeer = $get_spent_by_peer($bInitiatedByA ? $addressA : $addressB);
					$transferredFromPeerAsClaimedByPeer = var['spentBy' || ($bInitiatedByA ? 'A' : 'B')];
					require($transferredFromPeer > $transferredFromPeerAsClaimedByPeer, "the peer didn't lie in his favor");
				}`,
				messages: [
					// send all to the wronged party, whoever submits the proof (v1.2)
					{
						app: 'payment',
						payload: {
							asset: 'base',
							outputs: [
								{address: `{$wronged_party}`}
							]
						}
					},
					{
						if: `{$asset != 'base'}`,
						app: 'payment',
						payload: {
							asset: `{$asset}`,
							outputs: [
								{address: `{$wronged_party}`}
							]
						}
					},
					// indicate that the channel has been closed with a fraud proof submitted
					{
						app: 'data',
						payload: {
							closed: 1,
							fraud_proof: 1,
							period: `{var['period']}`,
							event_id: `{var['event_id']}`
						}
					},
					{
						app: 'state',
						state: `{
							var['period'] += 1;
							var['close_initiated_by'] = false;
							var['close_start_ts'] = false;
							var['balanceA'] = false;
							var['balanceB'] = false;
							var['spentByA'] = false;
							var['spentByB'] = false;
							var['event_id'] += 1;
						}`
					}
				]
			}
		]
	}
}
