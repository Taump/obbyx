{
  "$schema": "https://typedoc.org/schema.json",
  "name": "obbyx SDK reference",
  "entryPointStrategy": "packages",
  "entryPoints": ["packages/obyte", "packages/x402-obyte", "packages/sdk"],
  "packageOptions": {
    "entryPoints": ["src/index.ts"],
    "tsconfig": "tsconfig.json"
  },
  "out": "docs/public/api",
  "excludePrivate": true,
  "excludeInternal": true,
  "readme": "none",
  "gitRevision": "master",
  "treatWarningsAsErrors": false
}
